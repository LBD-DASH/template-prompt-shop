---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { withBase } from '../lib/url';
---
<Base title="Disclosure" description="Disclosure for Template and Prompt Shop: nothing is for sale, there are no affiliate links yet, and every pack is a planned offering." path="disclosure/">
  <PageHead title="Disclosure" />
  <div class="wrap read section prose">
<p><strong>Nothing is for sale.</strong> All packs are planned offerings. There is no checkout, cart or price.</p><p><strong>No affiliate links yet.</strong> Any partner link would be added only via a data file after a program approves us, and would be marked here and on the page.</p><p><strong>No invented proof.</strong> We show no reviews, testimonials, download counts, earnings or results because none exist.</p>
  </div>
</Base>
