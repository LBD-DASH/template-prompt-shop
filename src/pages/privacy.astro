---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { withBase } from '../lib/url';
---
<Base title="Privacy" description="Privacy notice for Template and Prompt Shop: we run no accounts, no checkout and no live forms, and collect no personal data through this site." path="privacy/">
  <PageHead title="Privacy" />
  <div class="wrap read section prose">
<p>This site is static. It has no accounts, no checkout, no cookies set by us and no analytics at the time of writing.</p><p>The enquiry page does not send or store anything yet. Hosting is on GitHub Pages, which may keep standard server logs under its own <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">privacy statement</a> (last checked 20 Nov 2026).</p><p>If a working enquiry form is added later, this page will be updated first.</p>
  </div>
</Base>
