---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { withBase } from '../lib/url';
---
<Base title="Enquire or Request a Quote" description="Enquiries for Template and Prompt Shop are coming soon. Nothing is collected or sent from this page yet, and nothing is for sale." path="enquire/">
  <PageHead title="Enquire or Request a Quote" />
  <div class="wrap read section prose">
<p class="callout"><strong>Enquiries are coming soon.</strong> This page does not send or store anything yet. There is no form backend and no payment.</p><p>When enquiries open, you will be able to say which collection interests you and what you would want in it. A quote would come before any purchase, and no prices are set today.</p>
  </div>
</Base>
